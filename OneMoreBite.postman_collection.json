{
  "info": {
    "_postman_id": "9b12a84d-28e6-42d4-a1e9-9a28e3b1f5d2",
    "name": "OneMoreBite API",
    "description": "Collection complète des routes OneMoreBite :\n1. Authentification Admin & Commerçant avec JWT et BCrypt\n2. Cycle de vie Commerçant (Inscription EN_ATTENTE -> Validation Admin ACTIF / REJETE)\n3. CRUD complet des Produits",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "commercant_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "nouveau_commercant_id",
      "value": "4",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentification & Sessions",
      "item": [
        {
          "name": "Login Admin (Succès)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 200 - Connexion Admin réussie\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Contient un token JWT et le rôle ADMIN\", function () {",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData.role).to.eql('ADMIN');",
                  "});",
                  "",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"admin_token\", jsonData.token);",
                  "    console.log(\"Token JWT admin mis à jour dans {{admin_token}}\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@enicar.com\",\n  \"motDePasse\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Connexion de l'administrateur unique (admin@enicar.com / admin). Le script de test enregistre automatiquement le token dans {{admin_token}}."
          },
          "response": []
        },
        {
          "name": "Vérifier Session (GET /auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 200 - Session active\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Informations de profil retournées\", function () {",
                  "    pm.expect(jsonData).to.have.property('email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Renvoie le profil de l'utilisateur connecté (Admin ou Commerçant) à partir du Bearer Token."
          },
          "response": []
        },
        {
          "name": "Déconnexion (POST /auth/logout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 200 - Déconnexion réussie\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Message de confirmation\", function () {",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"admin_token\", \"\");",
                  "pm.collectionVariables.set(\"commercant_token\", \"\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Invalide le token JWT côté serveur via la liste de révocation."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Workflow Commerçants (Inscription & Validation Admin)",
      "item": [
        {
          "name": "1. Inscription Commerçant (Statut initial EN_ATTENTE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 201 - Commerçant créé\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Le statut est EN_ATTENTE\", function () {",
                  "    pm.expect(jsonData.statut).to.eql('EN_ATTENTE');",
                  "});",
                  "",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"nouveau_commercant_id\", jsonData.id.toString());",
                  "    console.log(\"ID nouveau commerçant sauvegardé : \" + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Pâtisserie Saveurs & Délices\",\n  \"email\": \"patisserie@delices.tn\",\n  \"motDePasse\": \"pass1234\",\n  \"telephone\": \"71222333\",\n  \"localisation\": \"Ariana, Ennasr 2\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/commercant/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "commercant",
                "register"
              ]
            },
            "description": "Inscription d'un nouveau commerçant. Son mot de passe est haché avec BCrypt et son compte est créé avec le statut 'EN_ATTENTE'."
          },
          "response": []
        },
        {
          "name": "2. Tentative Login Commerçant non validé (Erreur 401 - En attente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 401 - Accès refusé car compte EN_ATTENTE\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Message explicite d'attente de validation\", function () {",
                  "    pm.expect(jsonData.erreur).to.include(\"en attente de validation\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patisserie@delices.tn\",\n  \"motDePasse\": \"pass1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/commercant/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "commercant",
                "login"
              ]
            },
            "description": "Démontre que le commerçant ne peut pas se connecter tant que son compte est EN_ATTENTE."
          },
          "response": []
        },
        {
          "name": "3. Admin: Lister les commerçants en attente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Retourne une liste de commerçants\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/commercants?statut=EN_ATTENTE",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "commercants"
              ],
              "query": [
                {
                  "key": "statut",
                  "value": "EN_ATTENTE"
                }
              ]
            },
            "description": "Route réservée à l'administrateur permettant de filtrer les commerçants qui attendent une validation."
          },
          "response": []
        },
        {
          "name": "4. Admin: Accepter le commerçant (Passage à ACTIF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 200 - Compte accepté\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Le statut est maintenant ACTIF\", function () {",
                  "    pm.expect(jsonData.statut).to.eql('ACTIF');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/commercants/{{nouveau_commercant_id}}/accepter",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "commercants",
                "{{nouveau_commercant_id}}",
                "accepter"
              ]
            },
            "description": "Action administrative qui valide le compte du commerçant et fait passer son statut à 'ACTIF'."
          },
          "response": []
        },
        {
          "name": "5. Login Commerçant après acceptation (Succès)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 200 - Connexion Commerçant réussie\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Rôle COMMERCANT dans le JWT\", function () {",
                  "    pm.expect(jsonData.role).to.eql('COMMERCANT');",
                  "});",
                  "",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"commercant_token\", jsonData.token);",
                  "    console.log(\"Token JWT commerçant sauvegardé\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patisserie@delices.tn\",\n  \"motDePasse\": \"pass1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/commercant/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "commercant",
                "login"
              ]
            },
            "description": "Après acceptation par l'admin, le commerçant peut se connecter et reçoit son token JWT avec le rôle COMMERCANT."
          },
          "response": []
        },
        {
          "name": "6. Admin: Rejeter un commerçant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 200 - Compte rejeté\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Le statut est REJETE\", function () {",
                  "    pm.expect(jsonData.statut).to.eql('REJETE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/commercants/{{nouveau_commercant_id}}/rejeter",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "commercants",
                "{{nouveau_commercant_id}}",
                "rejeter"
              ]
            },
            "description": "Action administrative pour refuser/rejeter un compte commerçant."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Produits",
      "item": [
        {
          "name": "Lister tous les produits",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"La réponse est un tableau\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/produits",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "produits"
              ]
            },
            "description": "Récupère tous les produits disponibles ordonnés par identifiant décroissant."
          },
          "response": []
        },
        {
          "name": "Obtenir un produit par ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/produits/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "produits",
                "1"
              ]
            },
            "description": "Récupère les détails d'un produit par son identifiant unique."
          },
          "response": []
        },
        {
          "name": "Créer un produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 201 - Produit créé\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Panier Pâtisseries du Jour\",\n  \"description\": \"Assortiment de 6 gâteaux et tartelettes\",\n  \"prix\": 12.500,\n  \"quantite\": 8,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1555507036-ab1f4038808a\",\n  \"dateExpiration\": \"2026-11-05\",\n  \"disponibilite\": true,\n  \"commercantId\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/produits",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "produits"
              ]
            },
            "description": "Crée un nouveau produit anti-gaspillage dans la base de données."
          },
          "response": []
        },
        {
          "name": "Modifier un produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 200 - Produit mis à jour\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Panier Viennoiseries Gourmand (Modifié)\",\n  \"description\": \"5 croissants et 3 pains au chocolat frais\",\n  \"prix\": 6.000,\n  \"quantite\": 12,\n  \"imageUrl\": \"https://example.com/images/viennoiseries.jpg\",\n  \"dateExpiration\": \"2026-11-02\",\n  \"disponibilite\": true,\n  \"commercantId\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/produits/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "produits",
                "1"
              ]
            },
            "description": "Met à jour les informations d'un produit existant."
          },
          "response": []
        },
        {
          "name": "Supprimer un produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 204 - Suppression réussie\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/produits/2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "produits",
                "2"
              ]
            },
            "description": "Supprime un produit par son ID."
          },
          "response": []
        }
      ]
    }
  ]
}
