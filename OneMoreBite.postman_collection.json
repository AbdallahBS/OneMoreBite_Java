                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Panier Pâtisseries du Jour\",\n  \"description\": \"Assortiment de 6 gâteaux et tartelettes\",\n  \"prix\": 12.500,\n  \"quantite\": 8,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1555507036-ab1f4038808a\",\n  \"dateExpiration\": \"2026-11-05\",\n  \"disponibilite\": true,\n  \"commercantId\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/produits",
