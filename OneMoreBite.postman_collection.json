                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Panier Viennoiseries Gourmand (Modifié)\",\n  \"description\": \"5 croissants et 3 pains au chocolat frais\",\n  \"prix\": 6.000,\n  \"quantite\": 12,\n  \"imageUrl\": \"https://example.com/images/viennoiseries.jpg\",\n  \"dateExpiration\": \"2026-11-02\",\n  \"disponibilite\": true,\n  \"commercantId\": 2\n}"
            },
            "url": {
