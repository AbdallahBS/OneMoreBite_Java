                  "pm.test(\"Statut HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"La réponse est un tableau\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/produits",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "produits"
              ]
            },
            "description": "Récupère tous les produits disponibles ordonnés par identifiant décroissant."
          },
          "response": []
