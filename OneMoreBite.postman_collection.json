                "exec": [
                  "pm.test(\"Statut HTTP 204 - Suppression réussie\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/produits/2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "produits",
