{
  "info": {
    "_postman_id": "9b12a84d-28e6-42d4-a1e9-9a28e3b1f5d2",
    "name": "OneMoreBite API",
    "description": "Collection complète des routes de l'API OneMoreBite (Authentification Administrateur avec session JWT, vérification de profil, et CRUD complet des produits).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentification Admin",
      "item": [
        {
          "name": "Login Admin (Succès)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 200 - Connexion réussie\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Contient un token JWT et le rôle ADMIN\", function () {",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData.role).to.eql('ADMIN');",
                  "});",
                  "",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"admin_token\", jsonData.token);",
                  "    console.log(\"Token JWT admin mis à jour dans {{admin_token}}\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@enicar.com\",\n  \"motDePasse\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authentifie l'administrateur unique par défaut (admin@enicar.com / admin) et génère une session JWT de 24h. Le script de test stocke automatiquement le token dans la variable {{admin_token}}."
          },
          "response": []
        },
        {
          "name": "Login Admin (Échec - Mot de passe incorrect)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 401 - Non autorisé\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@enicar.com\",\n  \"motDePasse\": \"mauvaismdp\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Test de validation d'erreur : vérifie qu'un mot de passe erroné renvoie bien une erreur 401 Unauthorized."
          },
          "response": []
        },
        {
          "name": "Session Admin (GET /auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 200 - Profil admin valide\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Profil administrateur vérifié\", function () {",
                  "    pm.expect(jsonData.email).to.eql('admin@enicar.com');",
                  "    pm.expect(jsonData.role).to.eql('ADMIN');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Vérifie la validité du token JWT dans l'en-tête Authorization: Bearer <token> et renvoie les informations de l'administrateur connecté."
          },
          "response": []
        },
        {
          "name": "Logout Admin (POST /auth/logout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut HTTP 200 - Déconnexion réussie\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Message de confirmation de déconnexion\", function () {",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "});",
                  "",
                  "// Nettoyer la variable admin_token après déconnexion",
                  "pm.collectionVariables.set(\"admin_token\", \"\");",
                  "console.log(\"Variable {{admin_token}} réinitialisée après déconnexion\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Révoque la session JWT côté serveur. Le token est ajouté à la liste des tokens invalidés et la variable {{admin_token}} est réinitialisée."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Produits",
      "item": [
        {
          "name": "Lister tous les produits",
          "event": [
